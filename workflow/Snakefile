# muODE Snakemake workflow
# =========================
# Orchestrates the embarrassingly-parallel per-MAG phases (QC -> reconstruct ->
# refine) and the integrative per-sample phases (assemble -> simulate -> perturb).
#
# Design notes
# ------------
# * Per-MAG work (reconstruction, refinement) fans out: one job per genome, so it
#   scales to hundreds/thousands of MAGs on a cluster (see profiles/slurm).
# * A *checkpoint* (`select_mags`) makes the set of MAGs that survive QC a
#   first-class, data-dependent input to the downstream aggregation, so only
#   good bins are ever modelled or simulated.
# * `reconstruct_report` aggregates every per-MAG QC into one
#   `reconstruction_summary.tsv` -- the table you read after a large run -- and
#   `assemble` uses it to drop non-simulatable models instead of aborting.
# * External tools (CarveMe, CheckM2) run in their own conda envs via `--use-conda`.
#   The muODE engine steps run in the active `muode` env (where you `pip install -e .`).
#
# Engines (`engine:` in config)
# ------------------------------
# * `carveme` (default) -- real reconstruction; needs the carveme conda env.
# * `stub`              -- dependency-free placeholder models so the whole DAG can
#                          be validated locally (e.g. aarch64). Run WITHOUT
#                          `--use-conda` in your active `muode` env. NOT science.
#
# Run (from the repo root):
#   conda activate muode
#   # full pipeline on a capable machine:
#   snakemake --use-conda --cores 8 --configfile config/config.yaml
#   # local end-to-end DAG smoke-test on the bundled stub MAGs:
#   snakemake --cores 4 --configfile config/config.demo.yaml

import glob
import os
from pathlib import Path

from snakemake.exceptions import WorkflowError

configfile: "config/config.yaml"

OUT = config["outdir"]
MAGS_DIR = config["mags_dir"]
EXT = config.get("mag_extension", "fna")
ENGINE = config.get("engine", "carveme")
UNIVERSE = config.get("universe", "bacteria")
SCRIPTS = os.path.join(workflow.basedir, "scripts")

MAGS = sorted(Path(p).stem for p in glob.glob(os.path.join(MAGS_DIR, f"*.{EXT}")))

# --- reconstruction engine dispatch (chosen once, at parse time) -----------
# CarveMe runs in its own conda env from the rule shell; the dependency-free
# `stub` engine is driven from Python in the active muode env.
if ENGINE == "carveme":
    RECON_CONDA = "envs/carveme.yaml"
    RECON_SHELL = (
        "prodigal -i {input.genome} -a {params.proteins} -p meta -q > {log} 2>&1 && "
        "carve {params.proteins} -o {output.model} -u %s {params.media_flag} >> {log} 2>&1"
        % UNIVERSE
    )
elif ENGINE == "stub":
    RECON_CONDA = "envs/muode.yaml"
    RECON_SHELL = (
        "python {SCRIPTS}/reconstruct_one.py {input.genome} {output.model} "
        "--engine stub > {log} 2>&1"
    )
else:
    raise WorkflowError(
        f"engine '{ENGINE}' is not wired into the workflow; use 'carveme' (default) "
        "or 'stub' (local DAG test). gapseq is available via `muode build --engine gapseq`."
    )


# --- final targets ---------------------------------------------------------
def final_targets():
    targets = [
        f"{OUT}/qc/reconstruction_summary.tsv",
        f"{OUT}/simulation/biomass.csv",
    ]
    if config.get("run_memote", False):
        targets.append(f"{OUT}/qc/memote/summary.txt")
    if config.get("benchmark"):
        targets.append(f"{OUT}/validation/report.json")
    if config.get("perturbation"):
        targets.append(f"{OUT}/perturbation/biomass.csv")
    return targets


rule all:
    input:
        final_targets(),


# --- Phase 0: MAG quality control -----------------------------------------
# CheckM2 is kept in the pipeline at all times but gated by `run_checkm2`.
# It is disabled by default (it cannot run on every architecture, e.g. aarch64);
# enable it on a capable machine by setting `run_checkm2: true`.
rule checkm2:
    input:
        MAGS_DIR,
    output:
        report=f"{OUT}/qc/quality_report.tsv",
    log:
        f"{OUT}/logs/checkm2.log",
    threads: config.get("threads", 4)
    conda:
        "envs/checkm2.yaml"
    shell:
        "checkm2 predict --input {input} --output-directory {OUT}/qc "
        "-x {EXT} --threads {threads} --force > {log} 2>&1"


checkpoint select_mags:
    # Decide which MAGs pass QC. If CheckM2 is disabled, keep them all. The
    # output list is what downstream aggregation expands over.
    input:
        report=(f"{OUT}/qc/quality_report.tsv" if config.get("run_checkm2", False) else []),
    output:
        passing=f"{OUT}/qc/passing_mags.txt",
    run:
        Path(output.passing).parent.mkdir(parents=True, exist_ok=True)
        if config.get("run_checkm2", False):
            from muode.qc import filter_mags

            keep = filter_mags(
                input.report,
                min_completeness=config.get("min_completeness", 50.0),
                max_contamination=config.get("max_contamination", 10.0),
            )
        else:
            keep = MAGS
        Path(output.passing).write_text("\n".join(keep) + "\n")


# --- Phase 1: reconstruction (per MAG) ------------------------------------
rule reconstruct:
    input:
        genome=f"{MAGS_DIR}/{{mag}}.{EXT}",
    output:
        model=f"{OUT}/models/draft/{{mag}}.xml",
    params:
        proteins=f"{OUT}/models/draft/{{mag}}.faa",
        media_flag=(f"-g {config['gapfill_media']}" if config.get("gapfill_media") else ""),
    threads: config.get("threads", 4)
    log:
        f"{OUT}/logs/reconstruct/{{mag}}.log",
    conda:
        RECON_CONDA
    shell:
        RECON_SHELL


# --- Phase 2/3: gap-filling + kinetics QC (per MAG) -----------------------
rule refine:
    input:
        model=f"{OUT}/models/draft/{{mag}}.xml",
    output:
        model=f"{OUT}/models/refined/{{mag}}.xml",
        qc=f"{OUT}/models/refined/{{mag}}.qc.json",
        kinetics=f"{OUT}/models/refined/{{mag}}.kinetics.json",
    params:
        universal=(f"--universal {config['universal_model']}" if config.get("universal_model") else ""),
        predict=("--predict-kinetics" if config.get("predict_kinetics", False) else ""),
        predictor=config.get("predictor", "heuristic"),
    log:
        f"{OUT}/logs/refine/{{mag}}.log",
    shell:
        "python {SCRIPTS}/refine_one.py {input.model} {output.model} "
        "--qc-json {output.qc} --kinetics-json {output.kinetics} "
        "--predictor {params.predictor} {params.predict} {params.universal} > {log} 2>&1"


# --- Phase 3b: reconstruction QC summary (aggregate over surviving MAGs) ---
def refined_qc(wildcards):
    ck = checkpoints.select_mags.get(**wildcards).output.passing
    mags = [m.strip() for m in open(ck) if m.strip()]
    return expand(f"{OUT}/models/refined/{{mag}}.qc.json", mag=mags)


rule reconstruct_report:
    input:
        qc=refined_qc,
    output:
        summary=f"{OUT}/qc/reconstruction_summary.tsv",
    run:
        from muode.qc import summarize_reconstruction

        Path(output.summary).parent.mkdir(parents=True, exist_ok=True)
        df = summarize_reconstruction(list(input.qc))
        df.to_csv(output.summary, sep="\t", index=False)
        n_ok = int(df["simulatable"].sum()) if "simulatable" in df.columns and not df.empty else 0
        print(f"reconstruction summary: {n_ok}/{len(df)} models simulatable -> {output.summary}")


# --- Phase 3c: full memote model QC (optional, `run_memote: true`) ---------
rule memote:
    input:
        model=f"{OUT}/models/refined/{{mag}}.xml",
    output:
        html=f"{OUT}/qc/memote/{{mag}}.html",
    log:
        f"{OUT}/logs/memote/{{mag}}.log",
    conda:
        "envs/carveme.yaml"
    shell:
        "memote report snapshot --filename {output.html} {input.model} > {log} 2>&1"


def memote_reports(wildcards):
    ck = checkpoints.select_mags.get(**wildcards).output.passing
    mags = [m.strip() for m in open(ck) if m.strip()]
    return expand(f"{OUT}/qc/memote/{{mag}}.html", mag=mags)


rule memote_all:
    input:
        memote_reports,
    output:
        summary=f"{OUT}/qc/memote/summary.txt",
    run:
        Path(output.summary).parent.mkdir(parents=True, exist_ok=True)
        Path(output.summary).write_text(
            "memote snapshot reports:\n" + "\n".join(sorted(map(str, input))) + "\n"
        )


# --- Phase 4a: assemble the community -------------------------------------
def passing_models(wildcards):
    ck = checkpoints.select_mags.get(**wildcards).output.passing
    mags = [m.strip() for m in open(ck) if m.strip()]
    return expand(f"{OUT}/models/refined/{{mag}}.xml", mag=mags)


def passing_kinetics(wildcards):
    ck = checkpoints.select_mags.get(**wildcards).output.passing
    mags = [m.strip() for m in open(ck) if m.strip()]
    return expand(f"{OUT}/models/refined/{{mag}}.kinetics.json", mag=mags)


def _subsample_flags():
    flags = []
    if config.get("max_species"):
        flags.append("--max-species %s" % config["max_species"])
    if config.get("min_abundance"):
        flags.append("--min-abundance %s" % config["min_abundance"])
    if config.get("abundance_coverage"):
        flags.append("--coverage %s" % config["abundance_coverage"])
    return " ".join(flags)


def _abundance_input(wildcards):
    # abundance is a user-supplied 2-column TSV (mag_id, rel_abundance); any
    # profiler is fine -- muODE does not care how the sample was profiled.
    return [config["abundance"]] if config.get("abundance") else []


rule assemble:
    input:
        models=passing_models,
        summary=f"{OUT}/qc/reconstruction_summary.tsv",
        abundance=_abundance_input,
    output:
        community=f"{OUT}/simulation/community.json",
    params:
        abundance=lambda wc, input: (f"--abundance {input.abundance}" if input.abundance else ""),
        subsample=_subsample_flags(),
        diet=config.get("diet", "western_gut"),
        total_biomass=config.get("total_biomass", 0.01),
    shell:
        "python {SCRIPTS}/assemble.py --models {input.models} --diet {params.diet} "
        "--total-biomass {params.total_biomass} --summary {input.summary} "
        "{params.abundance} {params.subsample} "
        "--out {output.community}"


# --- Phase 4b: dynamic simulation -----------------------------------------
rule simulate:
    input:
        community=f"{OUT}/simulation/community.json",
        # refined kinetics are produced alongside the models; depend on them so
        # the dynamic run waits for prediction when it is enabled.
        kinetics=(passing_kinetics if config.get("predict_kinetics", False) else []),
    output:
        biomass=f"{OUT}/simulation/biomass.csv",
    params:
        time=config.get("t_end", 24.0),
        step=config.get("dt", 0.1),
        vmax=config.get("default_vmax", 10.0),
        km=config.get("default_km", 0.01),
        kinetics_flag=(f"--kinetics {OUT}/models/refined" if config.get("predict_kinetics", False) else ""),
        enzyme_flag=("--enzyme-constraints" if config.get("enzyme_constraints", False) else ""),
    log:
        f"{OUT}/logs/simulate.log",
    shell:
        "muode simulate --community {input.community} --time {params.time} --step {params.step} "
        "--default-vmax {params.vmax} --default-km {params.km} "
        "{params.kinetics_flag} {params.enzyme_flag} "
        "--outdir {OUT}/simulation > {log} 2>&1"


# --- Phase 6: validation against a known community (optional) -------------
rule validate:
    input:
        biomass=f"{OUT}/simulation/biomass.csv",
    output:
        report=f"{OUT}/validation/report.json",
    params:
        expected=config.get("benchmark", ""),
    run:
        from muode.validate import BenchmarkExpectation, validate_outputs

        Path(output.report).parent.mkdir(parents=True, exist_ok=True)
        expectation = BenchmarkExpectation.from_file(params.expected)
        rep = validate_outputs(f"{OUT}/simulation", expectation)
        rep.to_json(output.report)
        print(f"benchmark '{rep.name}': {'PASSED' if rep.passed else 'FAILED'}")


# --- Phase 5: perturbation (optional) -------------------------------------
def _perturb_flags():
    cfg = config.get("perturbation") or {}
    flags = []
    if cfg.get("target_pathway"):
        flags.append('--target-pathway "%s"' % cfg["target_pathway"])
        flags.append("--efficacy %s" % cfg.get("efficacy", 0.95))
    if cfg.get("remove_species"):
        flags.append("--remove-species %s" % cfg["remove_species"])
    if cfg.get("knockout"):
        flags.append("--knockout %s" % cfg["knockout"])
    return " ".join(flags)


rule perturb:
    input:
        community=f"{OUT}/simulation/community.json",
    output:
        biomass=f"{OUT}/perturbation/biomass.csv",
    params:
        flags=_perturb_flags(),
        time=config.get("t_end", 24.0),
        step=config.get("dt", 0.1),
    log:
        f"{OUT}/logs/perturb.log",
    shell:
        "muode perturb --community {input.community} {params.flags} "
        "--time {params.time} --step {params.step} "
        "--outdir {OUT}/perturbation > {log} 2>&1"
