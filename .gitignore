# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Snakemake
.snakemake/

# muODE working dirs / heavy artifacts
results/
results_perturb_*/
results_gs/
models/draft_gems/
models/kinetic_gems/
simulation_env/
# derived diets (regenerated by derive_medium_modelseed.py once the GEMs exist)
**/western_gut_modelseed.csv
# gapseq scratch (RDS/blast intermediates, ~25 MB per genome).  Keep on disk -- it
# makes a re-fill cheap -- but never version it; only the .xml.gz models are tracked.
**/gapseq_work/
**/clark_gapseq_work/
*.xml
*.sbml
!examples/**/*.xml
*.log

# OS / editors
.DS_Store
.idea/
.vscode/

# Claude Code local settings (machine-specific; never version these)
.claude/settings.local.json
.claude/*.tmp*

# Clark et al. 2021 benchmark data -- fetched, not vendored (see muode.benchmarks.clark2021.fetch)
examples/benchmarks/clark2021/data/
examples/benchmarks/clark2021/*.csv
